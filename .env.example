APP_NAME=LedgerFlow
APP_ENV=local
# php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0 (04, 14). Set the password in your local .env only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ledgerflow
DB_USERNAME=ledgerflow
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Passwords (07 §2): Argon2id
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# Access tokens (07 §3.1). Keys are files outside version control: php artisan ledgerflow:jwt-keys
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_KEY_ID=k1
JWT_TTL_SECONDS=900

# Refresh cookie (07 §3.2). Keep Secure on; browsers accept it on http://127.0.0.1 and localhost.
REFRESH_COOKIE_SECURE=true
REFRESH_TTL_DAYS=14
# Comma-separated origins allowed to call /auth/refresh and /auth/logout (CSRF defence)
LEDGERFLOW_ALLOWED_ORIGINS=http://127.0.0.1:8000

# Name shown in authenticator apps (07 §5)
TWO_FACTOR_ISSUER=LedgerFlow
# Requests per minute per IP to /auth/* (05 §1 says 20)
AUTH_RATE_LIMIT_PER_IP=20
# Authenticated API calls per minute per user (05 §1 says 120)
API_RATE_LIMIT_PER_USER=120
