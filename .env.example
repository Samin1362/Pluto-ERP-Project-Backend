APP_NAME=Pluto
APP_ENV=local
# Filled in by ./scripts/setup.sh (php artisan key:generate)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose (docker-compose.yml). Ports on your machine; change them if they are taken.
HTTP_PORT=8080
DB_FORWARD_PORT=33060
MAILPIT_PORT=8025
# Your user and group ids, so files created in the container belong to you (setup.sh fills them in).
LOCAL_UID=1000
LOCAL_GID=1000

# MySQL 8.0 (04, 14) in the `mysql` service. setup.sh replaces change-me-locally with random passwords.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pluto
DB_USERNAME=pluto
DB_PASSWORD=change-me-locally
MYSQL_ROOT_PASSWORD=change-me-locally

# Redis in the `redis` service (phpredis extension)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mail goes to Mailpit locally: open http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@pluto.local
MAIL_FROM_NAME="${APP_NAME}"

# Passwords (07 §2): Argon2id
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# Access tokens (07 §3.1). Keys are files outside version control: php artisan pluto:jwt-keys
# Paths are relative to the project root (or absolute).
JWT_PRIVATE_KEY_PATH=storage/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/jwt-public.pem
JWT_KEY_ID=k1
JWT_TTL_SECONDS=900

# Refresh cookie (07 §3.2). Keep Secure on; browsers accept it on http://localhost.
REFRESH_COOKIE_SECURE=true
REFRESH_TTL_DAYS=14
# Comma-separated origins allowed to call /auth/refresh and /auth/logout (CSRF defence).
# 5173 = the frontend's Vite dev server, 8080 = this API.
PLUTO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Extra origins by pattern; * matches part of one DNS label, https only (e.g. Vercel preview URLs):
# PLUTO_ALLOWED_ORIGIN_PATTERNS=https://pluto-erp-frontend-*-<team>.vercel.app
PLUTO_ALLOWED_ORIGIN_PATTERNS=

# Shared with the Vercel /api proxy (same value as PROXY_SHARED_SECRET on Vercel). Only requests carrying it may set
# the client IP and host through X-Forwarded-*. Empty = trust no proxy (local development).
PROXY_SHARED_SECRET=
# Frontend address used in e-mails and invitations
APP_FRONTEND_URL=http://localhost:5173

# Name shown in authenticator apps (07 §5)
TWO_FACTOR_ISSUER=Pluto
# Requests per minute per IP to /auth/* (05 §1 says 20)
AUTH_RATE_LIMIT_PER_IP=20
# Authenticated API calls per minute per user (05 §1 says 120)
API_RATE_LIMIT_PER_USER=120
