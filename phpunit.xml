<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- A disposable MySQL 8.0 database; CI overrides these (docs/14 §8). Tests never touch other databases. -->
        <env name="DB_CONNECTION" value="mysql" force="false"/>
        <env name="DB_HOST" value="127.0.0.1" force="false"/>
        <env name="DB_PORT" value="3306" force="false"/>
        <env name="DB_DATABASE" value="ledgerflow_test" force="false"/>
        <env name="DB_USERNAME" value="root" force="false"/>
        <env name="DB_PASSWORD" value="" force="false"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Cheaper Argon2id in tests only; production uses 64 MiB / 4 passes (07 §2). -->
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="JWT_PRIVATE_KEY_PATH" value="storage/framework/testing/keys/jwt-private.pem"/>
        <env name="JWT_PUBLIC_KEY_PATH" value="storage/framework/testing/keys/jwt-public.pem"/>
        <env name="LEDGERFLOW_ALLOWED_ORIGINS" value="http://localhost"/>
    </php>
</phpunit>
