<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <!-- A disposable MySQL 8.0 database: the `mysql` compose service by default (`make test`); CI and other hosts
             override these through the environment (docs/14 §8). Tests never touch other databases. -->
        <env name="DB_CONNECTION" value="mysql" force="false"/>
        <env name="DB_HOST" value="mysql" force="false"/>
        <env name="DB_PORT" value="3306" force="false"/>
        <env name="DB_DATABASE" value="pluto_test" force="true"/>
        <env name="DB_USERNAME" value="root" force="false"/>
        <env name="DB_PASSWORD" value="" force="false"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <!-- Cheaper Argon2id in tests only; production uses 64 MiB / 4 passes (07 §2). -->
        <env name="ARGON_MEMORY" value="1024" force="true"/>
        <env name="ARGON_TIME" value="1" force="true"/>
        <env name="JWT_PRIVATE_KEY_PATH" value="storage/framework/testing/keys/jwt-private.pem" force="true"/>
        <env name="JWT_PUBLIC_KEY_PATH" value="storage/framework/testing/keys/jwt-public.pem" force="true"/>
        <env name="PLUTO_ALLOWED_ORIGINS" value="http://localhost" force="true"/>

        <!-- Laravel reads $_SERVER before $_ENV, and inside Docker $_SERVER holds the container's .env values
             (e.g. CACHE_STORE=redis, DB_DATABASE=pluto). Mirror every forced value there so tests stay isolated. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="DB_DATABASE" value="pluto_test" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="ARGON_MEMORY" value="1024" force="true"/>
        <server name="ARGON_TIME" value="1" force="true"/>
        <server name="JWT_PRIVATE_KEY_PATH" value="storage/framework/testing/keys/jwt-private.pem" force="true"/>
        <server name="JWT_PUBLIC_KEY_PATH" value="storage/framework/testing/keys/jwt-public.pem" force="true"/>
        <server name="PLUTO_ALLOWED_ORIGINS" value="http://localhost" force="true"/>
    </php>
</phpunit>
