# Live settings for the host machine (backlog P0.4-BE-02). Copy to .env.live (never committed; keep the real file in
# the team password manager). ./scripts/live.sh init fills every "generate" value with a random one.

APP_NAME=Pluto
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public site address; absolute URLs outside requests (requests through Vercel already use the Vercel host).
APP_URL=https://pluto-erp-project-frontend.vercel.app
APP_FRONTEND_URL=https://pluto-erp-project-frontend.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Local port for checks on the host (curl http://localhost:8090/api/ready); the internet reaches it via the tunnel.
HTTP_PORT=8090
APP_TARGET=prod
LOCAL_UID=1000
LOCAL_GID=1000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pluto
DB_USERNAME=pluto
DB_PASSWORD=generate
MYSQL_ROOT_PASSWORD=generate
# MySQL memory for indexes and data pages (P17.1-BE-02): about half the host's RAM if MySQL shares it with the app.
MYSQL_BUFFER_POOL_SIZE=1G

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# E-mail (owner decision 1 Nov 2026, PEP-407): Gmail / Google Workspace SMTP with an app password
# (Google account → Security → 2-Step Verification → App passwords). Until it is filled in, mail goes to the log.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@pluto.local
MAIL_FROM_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

JWT_PRIVATE_KEY_PATH=storage/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/jwt-public.pem
JWT_KEY_ID=k1
JWT_TTL_SECONDS=900

REFRESH_COOKIE_SECURE=true
REFRESH_TTL_DAYS=14
PLUTO_ALLOWED_ORIGINS=https://pluto-erp-project-frontend.vercel.app
# Vercel preview URLs of this project in team samin-israks-projects (…-<hash or git-branch>-samin-israks-projects.vercel.app).
PLUTO_ALLOWED_ORIGIN_PATTERNS=https://pluto-erp-project-frontend-*-samin-israks-projects.vercel.app

# Same value as PROXY_SHARED_SECRET on Vercel (P0.6-FE-03).
PROXY_SHARED_SECRET=generate

TWO_FACTOR_ISSUER=Pluto
AUTH_RATE_LIMIT_PER_IP=20
API_RATE_LIMIT_PER_USER=120

# Public address (P17.1-BE-01; runbook docs/runbooks/named-tunnel.md). Empty TUNNEL_TOKEN = quick tunnel (random URL).
# With a token from Cloudflare Zero Trust → Networks → Tunnels, the named tunnel serves https://PUBLIC_API_HOST.
TUNNEL_TOKEN=
PUBLIC_API_HOST=

# Error tracking (P17.1-BE-06): Sentry, off while the DSN is empty. Personal data is never sent (send_default_pii=false).
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Uptime and backup alerts (P17.1-BE-06): who gets the "backup failed" / "API down" e-mail.
PLUTO_ALERT_EMAIL=
