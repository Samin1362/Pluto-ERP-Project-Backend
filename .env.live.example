# Live settings for the host machine (backlog P0.4-BE-02). Copy to .env.live (never committed; keep the real file in
# the team password manager). ./scripts/live.sh init fills every "generate" value with a random one.

APP_NAME=LedgerFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public site address; absolute URLs outside requests (requests through Vercel already use the Vercel host).
APP_URL=https://pluto-erp-project-frontend.vercel.app
APP_FRONTEND_URL=https://pluto-erp-project-frontend.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Local port for checks on the host (curl http://localhost:8090/api/ready); the internet reaches it via the tunnel.
HTTP_PORT=8090
APP_TARGET=prod
LOCAL_UID=1000
LOCAL_GID=1000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ledgerflow
DB_USERNAME=ledgerflow
DB_PASSWORD=generate
MYSQL_ROOT_PASSWORD=generate

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# No SMTP provider yet (decision C4): e-mails are written to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@ledgerflow.local
MAIL_FROM_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

JWT_PRIVATE_KEY_PATH=storage/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/jwt-public.pem
JWT_KEY_ID=k1
JWT_TTL_SECONDS=900

REFRESH_COOKIE_SECURE=true
REFRESH_TTL_DAYS=14
LEDGERFLOW_ALLOWED_ORIGINS=https://pluto-erp-project-frontend.vercel.app
# Vercel preview URLs of this project in team samin-israks-projects (…-<hash or git-branch>-samin-israks-projects.vercel.app).
LEDGERFLOW_ALLOWED_ORIGIN_PATTERNS=https://pluto-erp-project-frontend-*-samin-israks-projects.vercel.app

# Same value as PROXY_SHARED_SECRET on Vercel (P0.6-FE-03).
PROXY_SHARED_SECRET=generate

TWO_FACTOR_ISSUER=LedgerFlow
AUTH_RATE_LIMIT_PER_IP=20
API_RATE_LIMIT_PER_USER=120
